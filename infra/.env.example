# Docker Compose env (project dir is `infra/`).
#
# Usage:
#   cd open-assistant
#   cp infra/.env.example infra/.env
#   docker compose -f infra/docker-compose.full.yml up

# --- Images (override for intranet registry) ---
FUNASR_IMAGE=registry.cn-hangzhou.aliyuncs.com/funasr_repo/funasr:funasr-runtime-sdk-online-cpu-0.1.13
COSYVOICE_IMAGE=cosyvoice:v1.0

# CosyVoice model id (ModelScope) or local dir path (if you bake/mount offline models)
# Note: we call the FastAPI `/inference_sft` endpoint, so an SFT-capable model is required.
COSYVOICE_MODEL_DIR=iic/CosyVoice-300M-SFT

# --- OpenCode ---
OPENCODE_SERVER_PASSWORD=opencode

# --- Gateway runtime ---
# Set to `mock` if you only want to test ASR/TTS/WS pipeline without LLM.
OA_LLM_MODE=opencode
OA_OPENCODE_EVENTS_MODE=sse

# Optional: increase when running real TTS on CPU / high concurrency (ms).
OA_GW_TURN_TIMEOUT_MS=

# Optional: gateway-side TTS concurrency limit (tune per hardware).
OA_GW_TTS_MAX_CONCURRENT_SYNTHESIS=

# Optional: tag-based authorization for rag.search / asset.search
OA_AUTH_TAGS_MODE=disabled
OA_AUTH_TAGS=
OA_AUTH_TAGS_CLAIM=tags
OA_OIDC_REQUIRE_TAGS=false

# Optional: protect Gateway /mcp (OpenCode -> Gateway)
OA_OPENCODE_MCP_TOKEN=

# Optional: protect Gateway /metrics
OA_METRICS_TOKEN=

# Optional: protect Gateway admin/audit endpoints (/audit/* + /admin/api/* + /admin/assets); also fallback for Media/RAG admin
OA_ADMIN_TOKEN=

# Optional: protect Media admin endpoints (/asset/list/upload/update/delete + /admin/assets); overrides OA_ADMIN_TOKEN
OA_MEDIA_ADMIN_TOKEN=

# Optional: protect RAG admin endpoints (/doc/* + /admin/search); overrides OA_ADMIN_TOKEN
OA_RAG_ADMIN_TOKEN=
