# Staging template (OA-OPS-105): real dependencies + low concurrency + perf evidence.
#
# Usage:
#   cd open-assistant
#   cp infra/.env.staging.example infra/.env
#   # edit infra/.env (images, model cache, tokens)
#   OA_FULL_COMPOSE_MODE=prod OA_FULL_BUILD=1 bun run ops:full:up-perf:all
#
# Artifacts:
#   open-assistant/test-results/perf-evidence-<runId>.json
#   open-assistant/test-results/perf-report-<runId>.json
#   open-assistant/test-results/perf-asrtts-report-<runId>.json

# --- Version (optional; useful when deploy excludes .git) ---
OA_BUILD_VERSION=
OA_BUILD_SHA=

# --- Images (override for intranet registry) ---
FUNASR_IMAGE=registry.cn-hangzhou.aliyuncs.com/funasr_repo/funasr:funasr-runtime-sdk-online-cpu-0.1.13
COSYVOICE_IMAGE=cosyvoice:v1.0
COSYVOICE_MODEL_DIR=iic/CosyVoice-300M-SFT

# --- OpenCode ---
OPENCODE_SERVER_PASSWORD=opencode

# --- Gateway runtime ---
OA_LLM_MODE=opencode
OA_OPENCODE_EVENTS_MODE=sse

# Low concurrency first (跑通全链路优先；后续再逐步加压)
OA_GW_MAX_SESSIONS=2
OA_GW_ASR_MAX_CONCURRENT_DECODE=1
OA_GW_TTS_MAX_CONCURRENT_SYNTHESIS=1
OA_GW_TURN_TIMEOUT_MS=300000

# --- Auth (optional) ---
OA_AUTH_MODE=disabled
OA_AUTH_TAGS_MODE=disabled
OA_OIDC_REQUIRE_TAGS=false

# If OA_AUTH_MODE != disabled, /mcp MUST be protected.
OA_OPENCODE_MCP_TOKEN=change-me
# Optional: previous /mcp token during rotation window.
OA_OPENCODE_MCP_TOKEN_PREVIOUS=

# Optional: protect /metrics and admin endpoints
OA_METRICS_TOKEN=
OA_ADMIN_TOKEN=

# --- Perf (used by `bun run ops:full:*perf*`) ---
# Keep low at first; but ensure enough samples for interrupt/assertion statistics.
OA_PERF_SESSIONS=3
OA_PERF_TURNS_PER_SESSION=2
OA_PERF_DELAY_MS=200
OA_PERF_SPEAK_RATIO=1.0
OA_PERF_INTERRUPT_PROB=0.5
OA_PERF_INTERRUPT_DELAY_MS=250
OA_PERF_TURN_TIMEOUT_MS=300000
OA_PERF_AUDIO_REALTIME=1

# --- SLA gate (enabled by default for staging go/no-go) ---
OA_PERF_ASSERT=1
OA_PERF_MAX_ERROR_RATE=0
OA_PERF10_REQUIRE_INTERRUPTS=false

# perf:10 thresholds
OA_PERF10_P95_TTS_TEXT_MS=10000
OA_PERF10_P95_FIRST_AUDIO_MS=60000
OA_PERF10_P95_TURN_TOTAL_MS=70000
# OA_PERF10_P95_INTERRUPT_MS=3000

# perf:asrtts thresholds
OA_PERF_P95_ASR_FINAL_MS=8000
OA_PERF_P95_TTS_TEXT_MS=10000
OA_PERF_P95_FIRST_AUDIO_MS=60000
OA_PERF_P95_FIRST_ALIGN_MS=10000
OA_PERF_P95_TURN_TOTAL_MS=70000
OA_PERF_P95_INTERRUPT_MS=3000
OA_PERF_REQUIRE_ALIGN=1
OA_PERF_MAX_ALIGN_MISSING_SEGMENTS=0

# Optional: set a stable run id (otherwise generated).
OA_PERF_RUN_ID=

# --- Keycloak (optional) ---
# KEYCLOAK_IMAGE=quay.io/keycloak/keycloak:latest
# KEYCLOAK_DB_IMAGE=postgres:16
# KEYCLOAK_DB_PASSWORD=keycloak
# KEYCLOAK_ADMIN=admin
# KEYCLOAK_ADMIN_PASSWORD=admin
