ARG BUN_IMAGE=oven/bun:1.3.6

FROM ${BUN_IMAGE}
WORKDIR /app

ARG OPENCODE_AI_VERSION=1.1.37

COPY infra/opencode/opencode.jsonc /app/opencode.jsonc
COPY .opencode /app/.opencode

# Install OpenCode plugin deps required by `.opencode/`.
RUN bun install --cwd /app/.opencode --frozen-lockfile

# Install the OpenCode server binary as a local dependency so runtime can run fully offline.
# `bunx --no-install opencode-ai ...` will resolve from /app/node_modules.
RUN printf '{"name":"openassistant-opencode","private":true,"dependencies":{"opencode-ai":"%s"}}\n' "${OPENCODE_AI_VERSION}" > /app/package.json
RUN bun install --production

EXPOSE 4096
CMD ["/app/node_modules/.bin/opencode", "serve", "--port", "4096", "--hostname", "0.0.0.0"]
