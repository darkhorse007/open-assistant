# Open Assistant Ubuntu 部署参数模板
# 用法：
#   cp infra/scripts/deploy-ubuntu.env.example infra/scripts/deploy-ubuntu.env
#   set -a; source infra/scripts/deploy-ubuntu.env; set +a
#   ./infra/scripts/deploy-ubuntu.sh up

# 仓库根目录（脚本默认自动推断；远程主机建议显式固定）
OA_ROOT=/opt/open-assistant

# mock|real
OA_DEPLOY_MODE=mock

# prod|dev
OA_DEPLOY_COMPOSE_MODE=prod

# 1=启用 NVIDIA GPU overlay，0=禁用
OA_DEPLOY_USE_GPU=1

# 仅在 prod 模式有效：1=构建镜像，0=跳过构建
OA_DEPLOY_BUILD=1

# mock|opencode（网关 LLM 路由模式）
OA_DEPLOY_LLM_MODE=mock

# readiness 探针
OA_DEPLOY_READY_URL=http://127.0.0.1:7001/readyz
OA_DEPLOY_READY_TIMEOUT_SEC=1200

# 设为 1 可跳过 docker --gpus 可用性探测（不推荐）
OA_DEPLOY_SKIP_DOCKER_GPU_TEST=0

# real 模式下若 CosyVoice 镜像由其他流程保障，可设为 1 跳过检查
OA_DEPLOY_SKIP_COSYVOICE_IMAGE_CHECK=0

# docker GPU 探测镜像
OA_DEPLOY_CUDA_TEST_IMAGE=nvidia/cuda:12.3.2-runtime-ubuntu22.04

# 可选：覆盖 CosyVoice 镜像（也可放在 infra/.env）
# COSYVOICE_IMAGE=registry.example.com/ai/cosyvoice:v1.0
