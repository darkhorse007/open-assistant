# Open Assistant Ubuntu 部署参数（mock 推荐模板）
# 适用场景：先验证 Gateway/Web/Admin/审计链路，不依赖 FunASR/CosyVoice

OA_ROOT=/opt/open-assistant

OA_DEPLOY_MODE=mock
OA_DEPLOY_COMPOSE_MODE=prod
OA_DEPLOY_USE_GPU=0
OA_DEPLOY_WITH_KEYCLOAK=0
OA_DEPLOY_BUILD=1
OA_DEPLOY_LLM_MODE=mock

OA_DEPLOY_READY_URL=http://127.0.0.1:7001/readyz
OA_DEPLOY_READY_TIMEOUT_SEC=1200

OA_DEPLOY_SKIP_DOCKER_GPU_TEST=1
OA_DEPLOY_SKIP_COSYVOICE_IMAGE_CHECK=1

OA_DEPLOY_CUDA_TEST_IMAGE=nvidia/cuda:12.3.2-runtime-ubuntu22.04
