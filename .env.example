# Local dev defaults (bun run dev:*)
#
# Copy to `.env` and tweak as needed.
#
# Note: docker compose uses `infra/.env` (project dir is `infra/`).

# --- Gateway ---
OA_GATEWAY_HOST=0.0.0.0
OA_GATEWAY_PORT=7001
OA_GW_MAX_SESSIONS=10
OA_GW_TURN_TIMEOUT_MS=60000
OA_GW_ASR_MAX_CONCURRENT_DECODE=4
OA_GW_ASR_QUEUE_MAX_FRAMES=50
OA_GW_ASR_IDLE_RELEASE_MS=5000
OA_GW_TTS_MAX_CONCURRENT_SYNTHESIS=2
OA_GW_TTS_SEGMENT_MAX_CHARS=180

OA_ASR_MODE=external
OA_ASR_WS_URL=ws://127.0.0.1:7002/asr

OA_TTS_MODE=external
OA_TTS_BASE_URL=http://127.0.0.1:7003

OA_MEDIA_MODE=external
OA_MEDIA_BASE_URL=http://127.0.0.1:7004

OA_RAG_MODE=external
OA_RAG_BASE_URL=http://127.0.0.1:7005

OA_LLM_MODE=opencode
OA_OPENCODE_BASE_URL=http://127.0.0.1:4096
OA_OPENCODE_USERNAME=opencode
OA_OPENCODE_PASSWORD=opencode
OA_OPENCODE_EVENTS_MODE=sse
# OA_OPENCODE_DIRECTORY=/path/to/workspace

# --- Auth (optional) ---
OA_AUTH_MODE=disabled
# OA_AUTH_TOKEN=change-me
OA_AUTH_TENANT=default
OA_AUTH_PROJECT=open-assistant
# OA_AUTH_TAGS_MODE=enforce
# OA_AUTH_TAGS=dept-a,finance
# OA_AUTH_TAGS_CLAIM=tags
# OA_OIDC_ISSUER=https://keycloak.example.com/realms/<realm>
# OA_OIDC_AUDIENCE=open-assistant-web
# OA_OIDC_JWKS_URL=
# OA_OIDC_REQUIRE_TENANT_PROJECT=true
# OA_OIDC_REQUIRE_TAGS=false
# OA_AUTH_SUB_CLAIM=sub
# OA_AUTH_TENANT_CLAIM=tenant
# OA_AUTH_PROJECT_CLAIM=project

# --- OpenCode -> Gateway MCP (optional; protects /mcp) ---
# OA_OPENCODE_MCP_TOKEN=change-me
# OA_OPENCODE_MCP_TOKEN_PREVIOUS=old-token-during-rotation

# --- Metrics (optional; protects /metrics) ---
# OA_METRICS_TOKEN=change-me

# --- Admin (optional; protects Gateway /audit/* + /admin/api/* + /admin/assets/*; also fallback for Media/RAG admin) ---
# OA_ADMIN_TOKEN=change-me

# --- Media admin (optional; overrides OA_ADMIN_TOKEN for Media service admin endpoints) ---
# OA_MEDIA_ADMIN_TOKEN=change-me

# --- RAG admin (optional; overrides OA_ADMIN_TOKEN for RAG service admin endpoints) ---
# OA_RAG_ADMIN_TOKEN=change-me
