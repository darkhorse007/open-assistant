# Web dev env (Vite).
#
# Usage:
#   cd open-assistant/apps/web
#   cp .env.example .env
#   bun run dev

# Gateway WS endpoint (optional; defaults to ws(s)://<current>/ws)
# VITE_GATEWAY_WS_URL=ws://localhost:7001/ws

# Optional: default token injected into the UI (can still edit in-page)
# VITE_OA_TOKEN=

# Optional: Keycloak / OIDC (Auth Code + PKCE)
# If set, the UI provides Sign in / Refresh / Sign out and manages the token in sessionStorage.
# VITE_OA_OIDC_ISSUER=https://keycloak.example.com/realms/<realm>
# VITE_OA_OIDC_CLIENT_ID=open-assistant-web
# VITE_OA_OIDC_SCOPE=openid profile email
# VITE_OA_OIDC_REDIRECT_URI=http://localhost:5173/

